# libs/ holds third-party mod jars (Waystones, Balm) that are needed only to
# *run* the dev client/server. They must never be committed: redistributing
# someone else's mod from this repository is not ours to do, and the build is
# designed to work without them (see the "libs/ is optional" note in build.gradle).
libs/

